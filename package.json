{
  "name": "dsh-codex-bridge",
  "description": "Local DSH plugin and Codex MCP bridge for approved Git worktree execution and independent review.",
  "version": "0.5.0",
  "type": "module",
  "main": "lib/src/index.js",
  "exports": {
    ".": "./lib/src/index.js",
    "./transport": "./lib/src/transport.js",
    "./package.json": "./package.json",
    "./client": "./lib/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "test": "node --test lib/test/*.test.js",
    "smoke": "node bin/bridge.mjs hello",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "prepack": "pnpm run build"
  },
  "license": "MIT",
  "bin": {
    "dsh-codex-bridge": "bin/bridge.mjs",
    "dsh-codex-mcp": "bin/mcp.mjs"
  },
  "engines": {
    "node": ">=22.16"
  },
  "files": [
    "bin/",
    "cordis.patch.yml",
    "README.md",
    "docs/",
    "scripts/build.mjs",
    "lib/src/",
    "lib/client.js"
  ],
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^18.3.31",
    "esbuild": "^0.25.12",
    "react": "^18.3.1",
    "typescript": "^5.9.3"
  }
}
